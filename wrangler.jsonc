{
  // Cloudflare Pages. `npm run build` writes the static site to dist/, and the
  // functions/ directory (the server-side Gemini calls, via ft-ai) is bundled automatically.
  //
  // Dashboard "Connect to Git": build command `npm run build`, output `dist`.
  // CLI: `npm run deploy` (wraps `wrangler pages deploy`).
  "name": "cyberpunk-trading-cards",
  "compatibility_date": "2026-08-02",
  "pages_build_output_dir": "./dist",
  // Gemini is reached through the shared ft-ai gateway (dev-projects/ft-ai).
  "services": [{ "binding": "FT_AI", "service": "ft-ai" }]
}
